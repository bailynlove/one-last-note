{
  "title": "One Last Note operations",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "timeseries",
      "title": "API requests by status",
      "targets": [{ "expr": "sum by (status) (rate(api_requests_total[5m]))", "legendFormat": "{{status}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "API p95 latency",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "targets": [{ "expr": "sum by (queue, state) (queue_jobs)", "legendFormat": "{{queue}} {{state}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Worker job outcomes",
      "targets": [{ "expr": "sum by (queue, status) (rate(worker_jobs_total[5m]))", "legendFormat": "{{queue}} {{status}}" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
