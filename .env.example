NODE_ENV=development
LOG_LEVEL=info

# API
PORT=4000
API_HOST=0.0.0.0

# Web
API_BASE_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://one_last_note:one_last_note@localhost:5432/one_last_note

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# S3-compatible object storage (S3Mock locally, Cloudflare R2 when deployed)
S3_ENDPOINT=http://localhost:9095
S3_REGION=us-east-1
S3_BUCKET=one-last-note
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
