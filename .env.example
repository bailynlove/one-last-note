NODE_ENV=development
LOG_LEVEL=info

# API
PORT=4000
API_HOST=0.0.0.0

# Web
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# Number of trusted proxy hops in front of the API (Render typically uses 1)
TRUST_PROXY_HOPS=0
# Shared secret for forwarding the web client's IP to the API
# AUTH_PROXY_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://one_last_note:one_last_note@localhost:5432/one_last_note

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# S3-compatible object storage (S3Mock locally, Cloudflare R2 when deployed)
S3_ENDPOINT=http://localhost:9095
S3_REGION=us-east-1
S3_BUCKET=one-last-note
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true

# Authentication (RESEND_API_KEY is required in production)
# RESEND_API_KEY=
AUTH_EMAIL_FROM="One Last Note <login@one-last-note.dev>"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
